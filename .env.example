# Public, non-secret GitHub App identifiers used only by the maintainer process.
BOULE_GITHUB_ORG=
BOULE_GITHUB_APP_ID=
BOULE_GITHUB_INSTALLATION_ID=

# Host path to a separately stored mode-0600 PEM. Never place its value here.
BOULE_GITHUB_APP_KEY_HOST_PATH=/absolute/private/path/boule-github-app.pem

# Path inside the maintainer container. Keep this value unchanged with the
# provided Compose overlay.
BOULE_GITHUB_APP_KEY_FILE=/run/secrets/boule-github-app.pem
