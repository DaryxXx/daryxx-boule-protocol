# Install this file as `.env` with mode 0600, then fill the public settings.
# Docker Compose reads it; the Boule CLI does not load `.env` automatically.
BOULE_PUBLIC_ORIGIN=
BOULE_GITHUB_ORG=
BOULE_GITHUB_APP_ID=
BOULE_GITHUB_INSTALLATION_ID=

# This is a path, not the credential. Store the GitHub App PEM outside the
# checkout in a 0700 directory, owned by runtime UID 10001, with mode 0600.
# Never paste PEM contents, tokens, passwords, wallets, or recovery data here.
BOULE_GITHUB_APP_KEY_HOST_PATH=/etc/boule/secrets/github-app.pem
